<h2>Transfer Evidence to Analyst</h2>

<div class="evidence-box">
    <p><strong>Case ID:</strong>
        <%= evidence.case_id %>
    </p>
    <p><strong>Description:</strong>
        <%= evidence.description %>
    </p>
    <p><strong>Status:</strong> Approved by Supervisor</p>
</div>

<form action="/evidence/transfer-to-analyst/<%= evidence.evidence_id %>" method="POST">
    <button type="submit" class="btn btn-primary">
        🔁 Transfer to Analyst
    </button>
</form>

<br>
<a href="/evidence/my-evidence">⬅ Back</a>