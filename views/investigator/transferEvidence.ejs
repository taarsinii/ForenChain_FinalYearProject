<h2>Transfer Evidence</h2>

<form action="/evidence/transfer/<%= evidence.evidence_id %>" method="POST">
    <p>Case ID: <%= evidence.case_id %>
    </p>
    <p>Description: <%= evidence.description %>
    </p>

    <label>Transfer To User ID:</label>
    <input type="number" name="to_user" required>

    <label>Transfer Type:</label>
    <select name="transfer_type">
        <option value="to_supervisor">To Supervisor</option>
        <option value="to_lab">To Lab</option>
    </select>

    <button type="submit">Transfer</button>
</form>
<a href="/evidence/my-evidence">⬅ Back</a>