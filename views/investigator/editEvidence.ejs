<h2>Edit & Resubmit Evidence</h2>

<p><strong>Case ID:</strong>
    <%= evidence.case_id %>
</p>

<p style="color:red;">
    <strong>Supervisor Rejection Reason:</strong><br>
    <%= evidence.supervisor_reason %>
</p>

<form method="POST">
    <label>Description</label><br>
    <textarea name="description" rows="5" required>
<%= evidence.description %>
    </textarea><br><br>

    <button type="submit">🔄 Resubmit Evidence</button>
</form>

<a href="/investigator/my-evidence">⬅ Back</a>