<h2>My Submitted Evidence</h2>

<table border="1">
    <tr>
        <th>Case ID</th>
        <th>Description</th>
        <th>Status</th>
        <th>Action</th>
    </tr>

    <% evidenceList.forEach(e=> { %>
        <tr>
            <td>
                <%= e.case_id %>
            </td>
            <td>
                <%= e.description %>
            </td>
            <td>
                <%= e.current_status %>
            </td>
            <td>
                <a href="/investigator/evidence/<%= e.evidence_id %>">
                    View Details
                </a>
            </td>
        </tr>
        <% }) %>
</table>