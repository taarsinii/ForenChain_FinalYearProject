<h2>My Submitted Evidence</h2>

<table border="1" cellpadding="10" cellspacing="0">
    <tr>
        <th>Case ID</th>
        <th>Description</th>
        <th>Status</th>
        <th>Supervisor Feedback</th>
        <th>Action</th>
    </tr>

    <% evidenceList.forEach(e=> { %>
        <tr>
            <td>
                <%= e.case_id %>
            </td>
            <td>
                <%= e.description %>
            </td>

            <!-- STATUS -->
            <td>
                <% if (e.current_status==='pending_supervisor' ) { %>
                    ⏳ Waiting for Supervisor
                    <% } else if (e.current_status==='approved_supervisor' ) { %>
                        ✅ Approved
                        <% } else if (e.current_status==='rejected' ) { %>
                            ❌ Rejected
                            <% } %>
            </td>

            <!-- SUPERVISOR FEEDBACK -->
            <td>
                <% if (e.current_status==='approved_supervisor' ) { %>
                    <strong>Notes:</strong>
                    <%= e.supervisor_reason || '—' %>

                        <% } else if (e.current_status==='rejected' ) { %>
                            <strong style="color:red;">Reason:</strong>
                            <%= e.supervisor_reason %>

                                <% } else { %>
                                    —
                                    <% } %>
            </td>

            <!-- ACTION BUTTONS -->
            <td>
                <% if (e.current_status==='rejected' ) { %>
                    <a href="/investigator/edit/<%= e.evidence_id %>">
                        ✏️ Edit & Resubmit
                    </a>

                    <% } else if (e.current_status==='approved_supervisor' ) { %>
                        <a href="/investigator/transfer/<%= e.evidence_id %>">
                            🔁 Transfer to Analyst
                        </a>

                        <% } else { %>
                            —
                            <% } %>
            </td>
        </tr>
        <% }) %>
</table>

<br>
<a href="/investigator/dashboard">⬅ Back to Dashboard</a>