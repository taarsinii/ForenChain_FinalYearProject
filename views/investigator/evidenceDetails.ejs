<h2>Evidence Details</h2>

<p><strong>Case ID:</strong>
    <%= evidence.case_id %>
</p>
<p><strong>Description:</strong>
    <%= evidence.description %>
</p>
<p><strong>Status:</strong>
    <%= evidence.current_status %>
</p>

<hr>

<% if (evidence.current_status==='approved_supervisor' ) { %>
    <h3 style="color:green;">Approved by Supervisor</h3>
    <p><strong>Supervisor Notes:</strong></p>
    <p>
        <%= evidence.supervisor_reason || "No notes provided" %>
    </p>
    <% } %>

        <% if (evidence.current_status==='rejected_supervisor' ) { %>
            <h3 style="color:red;">Rejected by Supervisor</h3>
            <p><strong>Rejection Reason:</strong></p>
            <p>
                <%= evidence.supervisor_reason %>
            </p>
            <% } %>

                <a href="/investigator/my-evidence">⬅ Back</a>