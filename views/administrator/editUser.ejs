<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit User | ForenChain</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');

        body {
            /* Radial gradient for depth */
            background: radial-gradient(circle at center, #111827 0%, #050a18 100%);
            color: #ffffff;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        .glass-card {
            /* Frosted glass effect */
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
            border-radius: 20px;
        }

        input,
        select {
            background: rgba(15, 23, 42, 0.8) !important;
            border: 1px solid rgba(59, 130, 246, 0.2) !important;
            color: white !important;
        }

        input:focus,
        select:focus {
            border-color: #3b82f6 !important;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
        }

        .update-btn {
            background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
            transition: all 0.3s ease;
        }

        .update-btn:hover {
            box-shadow: 0 0 20px rgba(37, 99, 235, 0.4);
            transform: translateY(-1px);
        }
    </style>
</head>

<body class="flex items-center justify-center min-h-screen p-6 relative">

    <div class="fixed inset-0 overflow-hidden -z-10 pointer-events-none">
        <div class="absolute top-[-10%] left-[-5%] w-[500px] h-[500px] rounded-full bg-blue-600/10 blur-[120px]"></div>
        <div class="absolute bottom-[-10%] right-[-5%] w-[500px] h-[500px] rounded-full bg-indigo-600/10 blur-[120px]">
        </div>
    </div>

    <div class="glass-card p-10 w-full max-w-lg">
        <div class="flex items-center space-x-4 mb-8">
            <div class="p-3 bg-blue-500/20 rounded-xl border border-blue-500/20">
                <i data-lucide="user-cog" class="text-blue-400 w-8 h-8"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold tracking-tight">Edit User</span></h1>
                <p class="text-gray-400 text-sm">Update credentials for ID: <%= user.user_id %>
                </p>
            </div>
        </div>

        <form action="/admin/users/edit/<%= user.user_id %>" method="POST" class="space-y-6">
            <div class="grid grid-cols-2 gap-5">
                <div class="col-span-2">
                    <label class="text-[11px] font-bold text-gray-500 uppercase tracking-widest ml-1">Full Name</label>
                    <input type="text" name="full_name" value="<%= user.full_name %>" required
                        class="w-full mt-1.5 p-3.5 rounded-xl outline-none transition-all">
                </div>

                <div>
                    <label class="text-[11px] font-bold text-gray-500 uppercase tracking-widest ml-1">Username</label>
                    <input type="text" name="username" value="<%= user.username %>" required
                        class="w-full mt-1.5 p-3.5 rounded-xl outline-none transition-all">
                </div>

                <div>
                    <label class="text-[11px] font-bold text-gray-500 uppercase tracking-widest ml-1">Access
                        Role</label>
                    <select name="role"
                        class="w-full mt-1.5 p-3.5 rounded-xl outline-none transition-all cursor-pointer">
                        <option value="administrator" <%=user.role==="administrator" ? "selected" : "" %>>Administrator
                        </option>
                        <option value="investigator" <%=user.role==="investigator" ? "selected" : "" %>>Investigator
                        </option>
                        <option value="supervisor" <%=user.role==="supervisor" ? "selected" : "" %>>Supervisor</option>
                        <option value="analyst" <%=user.role==="analyst" ? "selected" : "" %>>Analyst</option>
                        <option value="prosecutor" <%=user.role==="prosecutor" ? "selected" : "" %>>Prosecutor</option>
                    </select>
                </div>

                <div class="col-span-2">
                    <label class="text-[11px] font-bold text-gray-500 uppercase tracking-widest ml-1">Change
                        Password</label>
                    <input type="password" name="password" placeholder="••••••••"
                        class="w-full mt-1.5 p-3.5 rounded-xl outline-none transition-all">
                    <p class="text-[10px] text-gray-500 mt-2 flex items-center italic">
                        <i data-lucide="info" class="w-3 h-3 mr-1"></i> Leave blank to keep current password
                    </p>
                </div>
            </div>

            <div class="flex items-center justify-between pt-8 border-t border-white/5">
                <a href="/admin/users"
                    class="text-gray-400 hover:text-white transition-all text-sm flex items-center group">
                    <i data-lucide="arrow-left"
                        class="w-4 h-4 mr-2 transform group-hover:-translate-x-1 transition-transform"></i>
                    Back to List
                </a>
                <button type="submit" class="update-btn px-10 py-3.5 rounded-xl font-bold text-white shadow-lg">
                    Update User
                </button>
            </div>
        </form>
    </div>

    <script>
        // Initialize icons
        lucide.createIcons();
    </script>
</body>

</html>