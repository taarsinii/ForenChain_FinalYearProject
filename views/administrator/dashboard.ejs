<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ForenChain | Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body {
            background-color: #050a18;
            /* Deep dark blue background from image */
            color: #ffffff;
            font-family: 'Inter', sans-serif;
        }

        .sidebar-item-active {
            background: linear-gradient(90deg, #1e40af 0%, #3b82f6 100%);
            border-radius: 8px;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(59, 130, 246, 0.2);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            transition: transform 0.2s;
        }

        .stat-card:hover {
            transform: translateY(-2px);
            border-color: rgba(59, 130, 246, 0.5);
        }
    </style>
</head>

<body class="flex h-screen overflow-hidden">

    <aside class="w-64 border-r border-gray-800 flex flex-col p-6 space-y-8">
        <div class="flex items-center space-x-2 text-2xl font-bold tracking-tight">
            <span class="text-[#3b82f6] text-3xl ">§</span>
            <span>ForenChain</span>
        </div>

        <nav class="flex-1 space-y-2">
            <a href="/admin/dashboard" class="sidebar-item-active flex items-center space-x-3 p-3 transition">
                <i data-lucide="layout-grid" class="w-5 h-5"></i>
                <span>Dashboard</span>
            </a>
            <a href="/admin/users" class="flex items-center space-x-3 p-3 text-gray-400 hover:text-white transition">
                <i data-lucide="users" class="w-5 h-5"></i>
                <span>Manage Users</span>
            </a>
            <a href="/admin/audit-logs"
                class="flex items-center space-x-3 p-3 text-gray-400 hover:text-white transition">
                <i data-lucide="file-text" class="w-5 h-5"></i>
                <span>Audit Logs</span>
            </a>
            <a href="/admin/backups" class="flex items-center space-x-3 p-3 text-gray-400 hover:text-white transition">
                <i data-lucide="save" class="w-5 h-5"></i>
                <span>Backup & Restore</span>
            </a>
            <a href="/admin/settings" class="flex items-center space-x-3 p-3 text-gray-400 hover:text-white transition">
                <i data-lucide="settings" class="w-5 h-5"></i>
                <span>Settings</span>
            </a>
        </nav>
    </aside>

    <main class="flex-1 flex flex-col">
        <header class="flex items-center justify-between p-6">
            <h1 class="text-2xl font-semibold">Welcome, <span class="text-blue-400">Admin</span></h1>

            </div>
        </header>

        <section class="p-6 grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="stat-card p-6 rounded-xl flex items-center space-x-4">
                <div class="p-3 bg-blue-500/10 rounded-lg">
                    <i data-lucide="user-plus" class="text-blue-500 w-8 h-8"></i>
                </div>
                <div>
                    <p class="text-gray-400 text-sm">Active Users</p>
                    <h2 class="text-3xl font-bold">4</h2>
                </div>
            </div>

            <div class="stat-card p-6 rounded-xl flex items-center space-x-4">
                <div class="p-3 bg-blue-500/10 rounded-lg">
                    <i data-lucide="file-digit" class="text-blue-500 w-8 h-8"></i>
                </div>
                <div>
                    <p class="text-gray-400 text-sm">Today's Logs</p>
                    <h2 class="text-3xl font-bold">7</h2>
                </div>
            </div>

            <div class="stat-card p-6 rounded-xl flex items-center space-x-4">
                <div class="p-3 bg-blue-500/10 rounded-lg">
                    <i data-lucide="history" class="text-blue-500 w-8 h-8"></i>
                </div>
                <div>
                    <p class="text-gray-400 text-sm">Last Backup</p>
                    <h2 class="text-2xl font-bold">21/01/2026</h2>
                </div>
            </div>
        </section>

        <div class="absolute bottom-10 right-10 opacity-20">
            <i data-lucide="sparkle" class="w-12 h-12 text-blue-400"></i>
        </div>
    </main>

    <script>
        // Initialize icons
        lucide.createIcons();
    </script>
</body>

</html>