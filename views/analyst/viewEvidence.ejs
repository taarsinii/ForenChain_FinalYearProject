<h2>Evidence Details</h2>

<p><strong>Case ID:</strong>
    <%= evidence.case_id %>
</p>
<p><strong>Description:</strong>
    <%= evidence.description %>
</p>
<p><strong>Investigator:</strong>
    <%= evidence.investigator %>
</p>
<p><strong>Collected at:</strong>
    <%= evidence.timestamp_collected %>
</p>
<p><strong>Status:</strong>
    <%= evidence.current_status %>
</p>

<% if (evidence.photo_path) { %>
    <a href="/analyst/download/<%= evidence.evidence_id %>">Download Evidence File</a>
    <% } %>

        <br><br>
        <a href="/analyst/report/<%= evidence.evidence_id %>">Generate / Upload Forensic Report</a>