<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analyst Dashboard | ForenChain</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-dark: #05080f;
            --sidebar-bg: #070b14;
            --card-bg: #0c1220;
            --accent-blue: #3b82f6;
            --accent-purple: #8b5cf6;
            --accent-orange: #f59e0b;
            /* For Review Analysis */
            --text-main: #ffffff;
            --text-dim: #94a3b8;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            display: flex;
            min-height: 100vh;
        }

        /* --- Sidebar Styles --- */
        .sidebar {
            width: 240px;
            background-color: var(--sidebar-bg);
            border-right: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            flex-direction: column;
            padding: 20px 0;
        }

        .logo-section {
            padding: 0 25px 30px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .logo-symbol {
            color: #3b82f6;
            font-size: 1.875rem;
            font-weight: 700;
            line-height: 1;
        }

        .logo-text {
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.025em;
            color: #ffffff;
        }

        .nav-link {
            padding: 14px 25px;
            display: flex;
            align-items: center;
            gap: 15px;
            text-decoration: none;
            color: var(--text-dim);
            transition: 0.2s;
            position: relative;
        }

        .nav-link.active {
            color: var(--text-main);
            background: linear-gradient(90deg, rgba(59, 130, 246, 0.2) 0%, rgba(59, 130, 246, 0.05) 100%);
        }

        .nav-link.active::after {
            content: '';
            position: absolute;
            right: 0;
            top: 15%;
            height: 70%;
            width: 4px;
            background-color: var(--accent-blue);
            border-radius: 4px 0 0 4px;
        }

        .nav-link:hover {
            color: var(--text-main);
        }


        /* --- Main Content --- */
        .main-content {
            flex-grow: 1;
            padding: 26px 36px;
        }

        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 50px;
        }

        .user-pill {
            background: rgba(255, 255, 255, 0.05);
            padding: 6px 14px;
            border-radius: 50px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.85rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .status-dot {
            height: 7px;
            width: 7px;
            background-color: #10b981;
            border-radius: 50%;
            box-shadow: 0 0 8px #10b981;
        }

        .welcome-text {
            font-size: 2.8rem;
            font-weight: 600;
            margin-bottom: 40px;
            letter-spacing: -1px;
        }

        .section-label {
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--accent-blue);
            font-size: 0.75rem;
            font-weight: 700;
            margin-bottom: 25px;
            display: block;
        }

        /* --- Grid Layout to match image --- */
        .card-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .analyst-card {
            background: var(--card-bg);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 24px;
            padding: 40px 30px;
            text-align: left;
            backdrop-filter: blur(10px);
            display: flex;
            flex-direction: column;
            transition: transform 0.3s ease;
        }

        .analyst-card:hover {
            transform: translateY(-5px);
            border-color: rgba(255, 255, 255, 0.2);
        }

        .icon-box {
            width: 45px;
            height: 45px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 30px;
            font-size: 1.2rem;
            color: white;
        }

        .blue-box {
            background: var(--accent-blue);
        }

        .purple-box {
            background: var(--accent-purple);
        }

        .green-box {
            background: var(--accent-green);
        }

        .analyst-card h3 {
            font-size: 1.4rem;
            margin: 0 0 10px 0;
            font-weight: 600;
        }

        .analyst-card p {
            color: var(--text-dim);
            font-size: 0.95rem;
            margin-bottom: 40px;
            line-height: 1.4;
        }

        .action-btn {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            border: none;
            color: white;
            font-weight: 600;
            text-decoration: none;
            text-align: center;
            font-size: 0.95rem;
            margin-top: auto;
            transition: opacity 0.3s;
        }

        .action-btn:hover {
            opacity: 0.9;
        }

        .btn-blue {
            background: #3498db;
        }

        .btn-purple {
            background: #9b59b6;
        }

        .btn-green {
            background: #2ecc71;
        }

        .sidebar-divider {
            border: none;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            margin: 20px 25px;
        }

        .logout-link {
            color: #ef4444 !important;
            margin-bottom: 20px;
            font-weight: 500;
        }

        .grid-icon {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2px;
            width: 16px;
            height: 16px;
        }

        .grid-icon span {
            background-color: currentColor;
            border-radius: 1px;
        }
    </style>
</head>

<body>

    <nav class="sidebar">
        <div class="logo-section">
            <span class="logo-symbol">§</span>
            <span class="logo-text">ForenChain</span>
        </div>

        <a href="/analyst/dashboard" class="nav-link active">
            <i class="fa-solid fa-border-all"></i> Dashboard
        </a>
        <a href="/analyst/incoming" class="nav-link">
            <i class="fa-solid fa-file-import"></i> Incoming Evidence
        </a>
        <a href="/analyst/reports" class="nav-link">
            <i class="fa-solid fa-file-contract"></i> Forensic Reports
        </a>
        <a href="/analyst/ready" class="nav-link">
            <i class="fa-solid fa-gavel"></i> Transfer Reports
        </a>

        <div style="margin-top: auto;">
            <hr class="sidebar-divider">
            <a href="/logout" class="nav-link logout-link">
                <div class="grid-icon">
                    <span></span><span></span>
                    <span></span><span></span>
                </div>
                Logout
            </a>
        </div>
    </nav>

    <main class="main-content">
        <header class="header-top">
            <div style="font-weight: 600; color: var(--text-dim);">Analyst Dashboard</div>
            <div class="user-pill">
                <img src="https://ui-avatars.com/api/?name=Analyst&background=3b82f6&color=fff" alt="User"
                    style="width:22px; border-radius:50%;">
                <span>Analyst Session</span>
                <span class="status-dot"></span>
            </div>
        </header>

        <h1 class="welcome-text">Welcome, Analyst</h1>
        <span class="section-label">Quick Actions</span>

        <div class="card-grid">
            <div class="analyst-card">
                <div class="icon-box blue-box">
                    <i class="fa-solid fa-box-archive"></i>
                </div>
                <h3>Incoming Evidence</h3>
                <p>View and analyse incoming case files.</p>
                <a href="/analyst/incoming" class="action-btn btn-blue">View Cases</a>
            </div>

            <div class="analyst-card">
                <div class="icon-box purple-box">
                    <i class="fa-solid fa-file-lines"></i>
                </div>
                <h3>Uploaded Forensic Reports</h3>
                <p>Track status of submitted analyses.</p>
                <a href="/analyst/reports" class="action-btn btn-purple">Track Reports</a>
            </div>

            <div class="analyst-card">
                <div class="icon-box green-box">
                    <i class="fa-solid fa-gavel"></i>
                </div>
                <h3>Transfer Forensic Reports</h3>
                <p>Transfer Forensic Reports to Prosecutor.</p>
                <a href="/analyst/ready" class="action-btn btn-green">Track Reports</a>
            </div>
        </div>
    </main>

</body>

</html>