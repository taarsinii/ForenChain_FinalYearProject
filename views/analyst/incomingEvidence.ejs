<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Incoming Evidence | ForenChain</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-dark: #05080f;
            --sidebar-bg: #070b14;
            --card-bg: #0c1220;
            --accent-blue: #3b82f6;
            --accent-purple: #8b5cf6;
            --accent-orange: #f59e0b;
            /* For Review Analysis */
            --text-main: #ffffff;
            --text-dim: #94a3b8;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            display: flex;
            min-height: 100vh;
        }

        /* --- Sidebar Styles --- */
        .sidebar {
            width: 240px;
            background-color: var(--sidebar-bg);
            border-right: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            flex-direction: column;
            padding: 20px 0;
        }

        .logo-section {
            padding: 0 25px 30px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .logo-symbol {
            color: #3b82f6;
            font-size: 1.875rem;
            font-weight: 700;
            line-height: 1;
        }

        .logo-text {
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.025em;
            color: #ffffff;
        }

        .nav-link {
            padding: 14px 25px;
            display: flex;
            align-items: center;
            gap: 15px;
            text-decoration: none;
            color: var(--text-dim);
            transition: 0.2s;
            position: relative;
        }

        .nav-link.active {
            color: var(--text-main);
            background: linear-gradient(90deg, rgba(59, 130, 246, 0.2) 0%, rgba(59, 130, 246, 0.05) 100%);
        }

        .nav-link.active::after {
            content: '';
            position: absolute;
            right: 0;
            top: 15%;
            height: 70%;
            width: 4px;
            background-color: var(--accent-blue);
            border-radius: 4px 0 0 4px;
        }

        .nav-link:hover {
            color: var(--text-main);
        }

        .sidebar-divider {
            border: none;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            margin: 20px 25px;
        }

        .logout-link {
            color: #ef4444 !important;
            margin-bottom: 20px;
            font-weight: 500;
        }

        /* Main */
        .main-content {
            flex-grow: 1;
            padding: 26px 36px;
        }

        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 50px;
        }

        .page-title {
            font-size: 2.2rem;
            font-weight: 600;
            margin: 0;
        }

        .user-pill {
            background: rgba(255, 255, 255, 0.05);
            padding: 6px 14px;
            border-radius: 50px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.85rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .status-dot {
            height: 7px;
            width: 7px;
            background-color: #10b981;
            border-radius: 50%;
            box-shadow: 0 0 8px #10b981;
        }

        /* Table */
        .table-container {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 20px;
            backdrop-filter: blur(10px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            padding: 15px 20px;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 1px;
            color: var(--accent-blue);
            border-bottom: 1px solid var(--glass-border);
        }

        td {
            padding: 20px;
            font-size: 0.9rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
        }

        tr:hover {
            background: rgba(255, 255, 255, 0.02);
        }

        .status-badge {
            padding: 6px 12px;
            border-radius: 50px;
            font-size: 0.8rem;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(59, 130, 246, 0.1);
            color: #60a5fa;
            border: 1px solid rgba(59, 130, 246, 0.2);
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-decoration: none;
            padding: 10px 18px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.3s ease;
            background: rgba(59, 130, 246, 0.1);
            color: #60a5fa;
            border: 1px solid rgba(59, 130, 246, 0.4);
            white-space: nowrap;
        }

        .btn-action i {
            font-size: 0.9rem;
        }

        .btn-action:hover {
            background: var(--accent-blue);
            color: white;
            transform: translateY(-2px);
        }

        .sidebar-divider {
            border: none;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            margin: 20px 25px;
        }

        .logout-link {
            color: #ef4444 !important;
            margin-bottom: 20px;
            font-weight: 500;
        }

        .grid-icon {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2px;
            width: 16px;
            height: 16px;
        }

        .grid-icon span {
            background-color: currentColor;
            border-radius: 1px;
        }
    </style>
</head>

<body>

    <!-- Sidebar -->
    <nav class="sidebar">
        <div class="logo-section">
            <span class="logo-symbol">§</span>
            <span class="logo-text">ForenChain</span>
        </div>

        <a href="/analyst/dashboard" class="nav-link">
            <i class="fa-solid fa-border-all"></i> Dashboard
        </a>

        <a href="/analyst/incoming" class="nav-link active">
            <i class="fa-solid fa-file-import"></i> Incoming Evidence
        </a>

        <a href="/analyst/reports" class="nav-link">
            <i class="fa-solid fa-file-contract"></i> Forensic Reports
        </a>

        <a href="/analyst/ready" class="nav-link">
            <i class="fa-solid fa-gavel"></i> Transfer Reports
        </a>

        <div style="margin-top: auto;">
            <hr class="sidebar-divider">
            <a href="/logout" class="nav-link logout-link">
                <div class="grid-icon">
                    <span></span><span></span>
                    <span></span><span></span>
                </div>
                Logout
            </a>
        </div>
    </nav>
    <!-- Main Content -->
    <main class="main-content">
        <header class="header-top">
            <h1 class="page-title">Incoming Evidence (Lab)</h1>
            <div class="user-pill">
                <img src="https://ui-avatars.com/api/?name=Analyst&background=3b82f6&color=fff"
                    style="width:22px; border-radius:50%;">
                <span>Analyst Session</span>
                <span class="status-dot"></span>
            </div>
        </header>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Case ID</th>
                        <th>Description</th>
                        <th>Investigator</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% evidenceList.forEach(e=> { %>
                        <tr>
                            <td style="font-weight:600;color:var(--accent-blue)">
                                <%= e.case_id %>
                            </td>
                            <td>
                                <%= e.description %>
                            </td>
                            <td style="color:var(--text-dim)">
                                <i class="fa-solid fa-user-shield"></i>
                                <%= e.investigator %>
                            </td>
                            <td>
                                <span class="status-badge">
                                    <%= e.current_status %>
                                </span>
                            </td>
                            <td>
                                <a href="/analyst/view/<%= e.evidence_id %>" class="btn-action">
                                    <i class="fa-solid fa-download"></i> View/Download
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
        </div>

        <div style="margin-top:30px;">
            <a href="/analyst/dashboard" style="color:var(--text-dim);text-decoration:none">
                <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </main>

</body>

</html>