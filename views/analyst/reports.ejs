<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Forensic Reports | ForenChain</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-dark: #05080f;
            --card-bg: rgba(12, 18, 32, 0.85);
            --accent-blue: #3b82f6;
            --accent-soft: rgba(59, 130, 246, 0.15);
            --text-main: #ffffff;
            --text-dim: #94a3b8;
            --border-glass: rgba(255, 255, 255, 0.08);
            --success: #22c55e;
        }

        body {
            margin: 0;
            background: radial-gradient(circle at top, #0b1224, var(--bg-dark));
            font-family: 'Inter', sans-serif;
            color: var(--text-main);
            min-height: 100vh;
        }

        .container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 30px;
        }

        /* Header */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 35px;
        }

        .page-title {
            font-size: 2.1rem;
            font-weight: 600;
        }

        /* Card */
        .card {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 30px;
            border: 1px solid var(--border-glass);
            backdrop-filter: blur(12px);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.45);
        }

        /* Table */
        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--accent-blue);
            padding: 14px;
            border-bottom: 1px solid var(--border-glass);
        }

        td {
            padding: 18px 14px;
            font-size: 0.9rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
            vertical-align: middle;
        }

        tr:hover {
            background: rgba(255, 255, 255, 0.03);
        }

        /* Status Badge */
        .status-badge {
            padding: 6px 14px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .status-approved {
            background: rgba(34, 197, 94, 0.15);
            color: var(--success);
            border: 1px solid rgba(34, 197, 94, 0.3);
        }

        .status-pending {
            background: rgba(245, 158, 11, 0.15);
            color: #f59e0b;
            border: 1px solid rgba(245, 158, 11, 0.3);
        }

        /* Download Button */
        .btn-download {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            color: white;
            padding: 8px 16px;
            border-radius: 10px;
            font-size: 0.8rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: 0.3s;
        }

        .btn-download:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(59, 130, 246, 0.4);
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 50px;
            color: var(--text-dim);
            font-size: 0.95rem;
        }

        /* Footer Actions */
        .footer-actions {
            margin-top: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn-back {
            color: var(--text-dim);
            text-decoration: none;
            font-size: 0.9rem;
        }

        .btn-back:hover {
            color: var(--accent-blue);
        }

        .audit-note {
            font-size: 0.8rem;
            color: var(--text-dim);
            border-left: 3px solid var(--accent-blue);
            padding-left: 14px;
        }
    </style>
</head>

<body>

    <div class="container">

        <!-- Header -->
        <div class="page-header">
            <h1 class="page-title">Uploaded Forensic Reports</h1>
        </div>

        <!-- Reports Table -->
        <div class="card">

            <% if (reports.length===0) { %>
                <div class="empty-state">
                    <i class="fa-solid fa-folder-open" style="font-size: 2rem; margin-bottom: 15px;"></i>
                    <p>No forensic reports have been uploaded yet.</p>
                </div>
                <% } else { %>

                    <table>
                        <thead>
                            <tr>
                                <th>Case ID</th>
                                <th>Report File</th>
                                <th>Report Hash</th>
                                <th>Uploaded At</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% reports.forEach(r=> { %>
                                <tr>
                                    <td style="font-weight: 600; color: var(--accent-blue);">
                                        <%= r.case_id %>
                                    </td>

                                    <td>
                                        <a href="/<%= r.report_file_path %>" target="_blank" class="btn-download">
                                            <i class="fa-solid fa-file-pdf"></i> View PDF
                                        </a>
                                    </td>

                                    <td
                                        style="font-size: 0.75rem; color: var(--text-dim); max-width: 240px; word-break: break-all;">
                                        <%= r.report_hash %>
                                    </td>

                                    <td>
                                        <%= new Date(r.uploaded_at).toLocaleString() %>
                                    </td>

                                    <td>
                                        <% if (r.current_status==='approved' ) { %>
                                            <span class="status-badge status-approved">
                                                <i class="fa-solid fa-shield-check"></i> Approved
                                            </span>
                                            <% } else { %>
                                                <span class="status-badge status-pending">
                                                    <i class="fa-solid fa-clock"></i> Pending
                                                </span>
                                                <% } %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>

                    <% } %>

        </div>

        <!-- Footer -->
        <div class="footer-actions">
            <a href="/analyst/dashboard" class="btn-back">
                <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
            </a>

            <div class="audit-note">
                All reports are cryptographically hashed and audit-logged.
            </div>
        </div>

    </div>

</body>

</html>