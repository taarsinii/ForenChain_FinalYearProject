<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pending Analysis | ForenChain</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-dark: #05080f;
            --sidebar-bg: #070b14;
            --card-bg: rgba(12, 18, 32, 0.8);
            --accent-blue: #3b82f6;
            --accent-purple: #8b5cf6;
            --text-main: #ffffff;
            --text-dim: #94a3b8;
            --glass-border: rgba(255, 255, 255, 0.08);
        }

        body {
            margin: 0;
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            display: flex;
            min-height: 100vh;
        }

        /* --- Sidebar Styles --- */
        .sidebar {
            width: 240px;
            background-color: var(--sidebar-bg);
            border-right: 1px solid var(--glass-border);
            display: flex;
            flex-direction: column;
            padding: 20px 0;
            position: sticky;
            top: 0;
            height: 100vh;
        }

        .logo-section {
            padding: 0 25px 30px;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .logo-symbol {
            color: var(--accent-blue);
            font-size: 1.875rem;
            font-weight: 700;
        }

        .logo-text {
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.025em;
            color: #ffffff;
        }

        .nav-link {
            padding: 14px 25px;
            display: flex;
            align-items: center;
            gap: 15px;
            text-decoration: none;
            color: var(--text-dim);
            transition: 0.2s;
            position: relative;
        }

        .nav-link.active {
            color: var(--text-main);
            background: linear-gradient(90deg, rgba(59, 130, 246, 0.2) 0%, rgba(59, 130, 246, 0.05) 100%);
        }

        .nav-link.active::after {
            content: '';
            position: absolute;
            right: 0;
            top: 15%;
            height: 70%;
            width: 4px;
            background-color: var(--accent-blue);
            border-radius: 4px 0 0 4px;
        }

        /* --- Main Content --- */
        .main-content {
            flex-grow: 1;
            padding: 40px 50px;
        }

        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 50px;
        }

        .page-title {
            font-size: 2.2rem;
            font-weight: 600;
            margin: 0;
        }

        /* --- High-Tech Table Styling --- */
        .table-container {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 20px;
            backdrop-filter: blur(10px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        th {
            padding: 15px 20px;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 1px;
            color: var(--accent-blue);
            border-bottom: 1px solid var(--glass-border);
        }

        td {
            padding: 20px;
            font-size: 0.9rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            vertical-align: middle;
        }

        tr:hover {
            background: rgba(255, 255, 255, 0.02);
        }

        /* Status Badge */
        .status-badge {
            padding: 6px 12px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 500;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(139, 92, 246, 0.1);
            color: var(--accent-purple);
            border: 1px solid rgba(139, 92, 246, 0.2);
        }

        /* Action Buttons */
        .btn-action {
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 0.85rem;
            transition: 0.3s;
            display: inline-block;
            background: rgba(59, 130, 246, 0.2);
            color: #60a5fa;
            border: 1px solid #3b82f6;
        }

        .btn-action:hover {
            filter: brightness(1.2);
            transform: translateY(-2px);
            background: var(--accent-blue);
            color: white;
        }

        .user-pill {
            background: rgba(255, 255, 255, 0.05);
            padding: 6px 14px;
            border-radius: 50px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.85rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--text-main);
        }

        .status-dot {
            height: 7px;
            width: 7px;
            background-color: #10b981;
            border-radius: 50%;
            box-shadow: 0 0 8px #10b981;
        }

        .sidebar-divider {
            border: none;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            margin: 20px 25px;
        }

        .logout-link {
            color: #ef4444 !important;
            margin-bottom: 20px;
            font-weight: 500;
        }

        .grid-icon {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2px;
            width: 16px;
            height: 16px;
        }

        .grid-icon span {
            background-color: currentColor;
            border-radius: 1px;
        }
    </style>
</head>

<body>

    <nav class="sidebar">
        <div class="logo-section">
            <span class="logo-symbol">§</span>
            <span class="logo-text">ForenChain</span>
        </div>

        <a href="/supervisor/dashboard" class="nav-link">
            <i class="fa-solid fa-border-all"></i> Dashboard
        </a>
        <a href="/supervisor/pending" class="nav-link">
            <i class="fa-solid fa-clock-rotate-left"></i> Pending Evidence
        </a>
        <a href="/supervisor/analysis/pending" class="nav-link active">
            <i class="fa-solid fa-magnifying-glass-chart"></i> Pending Analysis
        </a>

        <div style="margin-top: auto;">
            <hr class="sidebar-divider">
            <a href="/logout" class="nav-link logout-link">
                <div class="grid-icon">
                    <span></span><span></span>
                    <span></span><span></span>
                </div>
                Logout
            </a>
        </div>
    </nav>

    <main class="main-content">
        <header class="header-top">
            <h1 class="page-title">Pending Forensic Analysis Review</h1>
            <div class="user-pill">
                <img src="https://ui-avatars.com/api/?name=Supervisor&background=8b5cf6&color=fff" alt="User"
                    style="width:22px; border-radius:50%;">
                <span>Supervisor Session</span>
                <span class="status-dot"></span>
            </div>
        </header>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Case ID</th>
                        <th>Forensic Analyst</th>
                        <th>Current Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (evidenceList.length===0) { %>
                        <tr>
                            <td colspan="4" style="text-align: center; color: var(--text-dim); padding: 40px;">
                                <i class="fa-solid fa-inbox"
                                    style="display: block; font-size: 2rem; margin-bottom: 10px;"></i>
                                No forensic analysis reports pending review.
                            </td>
                        </tr>
                        <% } else { %>
                            <% evidenceList.forEach(e=> { %>
                                <tr>
                                    <td style="font-weight: 600; color: var(--accent-blue);">
                                        #<%= e.case_id %>
                                    </td>
                                    <td style="color: var(--text-main);">
                                        <i class="fa-solid fa-user-gear"
                                            style="font-size: 0.8rem; margin-right: 8px; color: var(--accent-purple);"></i>
                                        <%= e.analyst %>
                                    </td>
                                    <td>
                                        <span class="status-badge">
                                            <i class="fa-solid fa-flask-vial"></i>
                                            <%= e.current_status.replace(/_/g, ' ' ) %>
                                        </span>
                                    </td>
                                    <td>
                                        <a href="/supervisor/analysis/review/<%= e.evidence_id %>" class="btn-action">
                                            <i class="fa-solid fa-file-signature"></i> Review Report
                                        </a>
                                    </td>
                                </tr>
                                <% }) %>
                                    <% } %>
                </tbody>
            </table>
        </div>

        <div style="margin-top: 30px;">
            <a href="/supervisor/dashboard" style="color: var(--text-dim); text-decoration: none; font-size: 0.9rem;">
                <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>
    </main>
</body>

</html>