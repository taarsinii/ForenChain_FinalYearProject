<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Supervisor Review | Digital Forensic System</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        :root {
            --bg-dark: #0f172a;
            --bg-gradient: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            --panel-bg: rgba(30, 41, 59, 0.7);
            --accent-blue: #0ea5e9;
            --accent-glow: rgba(14, 165, 233, 0.3);
            --text-main: #f1f5f9;
            --text-muted: #94a3b8;
            --danger: #ef4444;
            --border-color: rgba(255, 255, 255, 0.1);
        }

        * {
            box-sizing: border-box;
            scrollbar-width: thin;
            scrollbar-color: var(--accent-blue) var(--bg-dark);
        }

        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: var(--bg-dark);
            background-image:
                radial-gradient(at 0% 0%, rgba(14, 165, 233, 0.15) 0, transparent 50%),
                radial-gradient(at 100% 100%, rgba(30, 58, 138, 0.3) 0, transparent 50%);
            color: var(--text-main);
            min-height: 100vh;
            padding: 40px 20px;
        }

        .container {
            max-width: 1000px;
            margin: auto;
            background: var(--panel-bg);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        /* Header Styling */
        h2 {
            font-size: 32px;
            font-weight: 700;
            margin: 0;
            color: var(--accent-blue);
            letter-spacing: -0.025em;
        }

        .subtitle {
            color: var(--text-muted);
            margin-bottom: 30px;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* Alert Box */
        .warning {
            background: rgba(14, 165, 233, 0.1);
            border-left: 4px solid var(--accent-blue);
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 30px;
            font-size: 15px;
            line-height: 1.6;
        }

        /* Section Cards */
        .section {
            border-top: 1px solid var(--border-color);
            padding-top: 25px;
            margin-bottom: 35px;
        }

        h3 {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* Data Display Grid */
        .meta-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            background: rgba(15, 23, 42, 0.4);
            padding: 20px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
        }

        .meta-item label {
            display: block;
            color: var(--text-muted);
            font-size: 12px;
            margin-bottom: 4px;
            text-transform: uppercase;
        }

        .meta-item span {
            font-weight: 500;
            color: var(--text-main);
        }

        /* Analysis Box Arrangement (From Picture) */
        .analysis-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        /* Inputs & Textareas */
        label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 8px;
        }

        textarea {
            width: 100%;
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid var(--border-color);
            border-radius: 6px;
            color: #cbd5e1;
            padding: 12px;
            font-size: 14px;
            resize: none;
            transition: all 0.3s;
        }

        textarea.readonly {
            border-left: 3px solid var(--accent-blue);
            background: rgba(14, 165, 233, 0.05);
        }

        /* File Upload Zone (The "Nice" Part) */
        .file-drop-zone {
            border: 2px dashed var(--border-color);
            border-radius: 10px;
            padding: 30px;
            text-align: center;
            background: rgba(15, 23, 42, 0.3);
            cursor: pointer;
            transition: 0.3s;
        }

        .file-drop-zone:hover {
            border-color: var(--accent-blue);
            background: rgba(14, 165, 233, 0.05);
        }

        /* Buttons */
        .actions {
            display: flex;
            gap: 12px;
            margin-top: 20px;
        }

        .btn {
            padding: 12px 24px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            border: none;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
        }

        .btn.approve {
            background: var(--accent-blue);
            color: white;
            box-shadow: 0 4px 14px var(--accent-glow);
        }

        .btn.reject {
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger);
            border: 1px solid var(--danger);
        }

        .btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.1);
        }

        .status-badge {
            background: #f59e0b;
            color: #000;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 800;
        }

        footer {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid var(--border-color);
            color: var(--text-muted);
            font-size: 12px;
            display: flex;
            justify-content: space-between;
        }
    </style>
</head>

<body>

    <div class="container">
        <header>
            <h2>Supervisor Review – Digital Forensic Analysis</h2>
            <div class="subtitle">Secure Evidence Verification System v2.4</div>
        </header>

        <div class="warning">
            <strong>System Protocol:</strong> You are performing a formal review of analyst evidence. Per procedural
            requirements,
            a screen recording or CCTV footage of this verification session must be attached to the final approval.
        </div>

        <div class="section">
            <h3><i data-lucide="database"></i> Evidence Information</h3>
            <div class="meta-grid">
                <div class="meta-item">
                    <label>Case ID</label>
                    <span>
                        <%= evidence.case_id %>
                    </span>
                </div>
                <div class="meta-item">
                    <label>Investigator</label>
                    <span>
                        <%= evidence.investigator_full_name %>
                    </span>
                </div>
                <div class="meta-item">
                    <label>Evidence Description</label>
                    <span>
                        <%= evidence.description %>
                    </span>
                </div>
                <div class="meta-item">
                    <label>Review Status</label>
                    <span class="status-badge">
                        <%= evidence.current_status %>
                    </span>
                </div>
            </div>
            <p style="margin-top: 20px;">
                <button class="btn"
                    style="background: rgba(255,255,255,0.05); color: var(--text-main); border: 1px solid var(--border-color);">
                    <i data-lucide="download"></i> Download Source Evidence
                </button>
            </p>
        </div>

        <div class="section">
            <h3><i data-lucide="file-search"></i> Analyst Analysis Findings</h3>
            <div class="analysis-grid">
                <div>
                    <label>Tools Used</label>
                    <textarea class="readonly" readonly rows="2"><%= analysis?.tools_used || '-' %></textarea>
                </div>
            </div>

            <div style="margin-top: 20px;">
                <label>Methodology</label><textarea class="readonly" readonly
                    rows="3"><%= analysis?.methodology || '-' %></textarea>

            </div>

            <div style="margin-top: 20px;">
                <label>Observations</label><textarea class="readonly" readonly
                    rows="4"><%= analysis?.observations || '-' %></textarea>
            </div>

            <div style="margin-top: 20px;">
                <label>Conclusion</label>
                            <textarea class="readonly" readonly rows="4"><%= analysis?.conclusion || '-' %></textarea>
            </div>

        </div>

        <div class="section"
            style="background: rgba(14, 165, 233, 0.03); border-radius: 12px; padding: 25px; border: 1px solid rgba(14, 165, 233, 0.2);">
            <h3><i data-lucide="shield-check"></i> Final Verification</h3>

            <form action="/approve" method="POST" enctype="multipart/form-data">
                <label>Supervision Proof (Video Recording)</label>
                <div class="file-drop-zone" onclick="document.getElementById('videoFile').click()">
                    <i data-lucide="video"
                        style="width: 40px; height: 40px; color: var(--accent-blue); margin-bottom: 10px;"></i>
                    <p style="margin: 0; font-weight: 500;">Click to upload CCTV / Screen Recording (MP4)</p>
                    <p style="margin: 5px 0 0 0; font-size: 12px; color: var(--text-muted);">Proof of physical
                        supervision required for chain-of-custody.</p>
                    <input type="file" id="videoFile" name="supervisor_video" accept="video/*" style="display: none;"
                        required>
                </div>

                <div style="margin-top: 20px;">
                    <label>Notes</label>
                    <textarea name="supervisor_notes" rows="3"
                        placeholder="Verification notes, supervision confirmation, or observations"></textarea>
                </div>

                <div class="actions">
                    <button type="submit" class="btn approve">
                        <i data-lucide="check-circle"></i> Authenticate & Approve Case
                    </button>
                </div>
            </form>
        </div>

        <div class="section">
            <h3><i data-lucide="alert-octagon"></i> Rejection</h3>
            <form action="/reject" method="POST">
                <label>Reject Forensic Analysis</label>
                <textarea name="reason" rows="2" placeholder="Detail the errors found in the analysis..."></textarea>
                <div class="actions">
                    <button type="submit" class="btn reject">Reject Analysis</button>
                    <a href="/pending"
                        style="color: var(--text-muted); font-size: 13px; align-self: center; text-decoration: none;">Return
                        to Dashboard</a>
                </div>
            </form>
        </div>

        <footer>
            <span>© 2026 Digital Forensic Intelligence Unit</span>
            <span>System Audit: <span style="color: var(--accent-blue);">ACTIVE</span></span>
        </footer>
    </div>

    <script>
        // Initialize Lucide icons
        lucide.createIcons();
    </script>
</body>

</html>