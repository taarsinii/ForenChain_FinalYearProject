<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Supervisor Review | Digital Forensic System</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
        :root {
            --bg-dark: #020617;
            /* Deeper black-blue */
            --panel-bg: rgba(15, 23, 42, 0.8);
            --accent-blue: #0ea5e9;
            --accent-glow: rgba(14, 165, 233, 0.3);
            --text-main: #f1f5f9;
            --text-muted: #94a3b8;
            --danger: #ef4444;
            --border-color: rgba(14, 165, 233, 0.2);
        }

        /* CARD BORDER GLOW ANIMATION */
        @keyframes card-breathe {

            0%,
            100% {
                box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7), 0 0 15px rgba(14, 165, 233, 0.1);
                border-color: rgba(14, 165, 233, 0.2);
            }

            50% {
                box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7), 0 0 30px rgba(14, 165, 233, 0.25);
                border-color: rgba(14, 165, 233, 0.5);
            }
        }

        /* BUTTON ANIMATIONS */
        @keyframes beacon-glow {
            0% {
                box-shadow: 0 0 0 0 rgba(14, 165, 233, 0.7);
            }

            70% {
                box-shadow: 0 0 0 12px rgba(14, 165, 233, 0);
            }

            100% {
                box-shadow: 0 0 0 0 rgba(14, 165, 233, 0);
            }
        }

        @keyframes heartbeat-scale {

            0%,
            90%,
            100% {
                transform: scale(1);
            }

            93% {
                transform: scale(1.04);
            }

            96% {
                transform: scale(0.98);
            }
        }

        * {
            box-sizing: border-box;
            scrollbar-width: thin;
            scrollbar-color: var(--accent-blue) var(--bg-dark);
        }

        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            /* THE BEST BACKGROUND: GRID + RADIAL GLOW */
            background-image:
                linear-gradient(rgba(14, 165, 233, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(14, 165, 233, 0.03) 1px, transparent 1px),
                radial-gradient(at 0% 0%, rgba(14, 165, 233, 0.08) 0, transparent 50%),
                radial-gradient(at 100% 100%, rgba(30, 58, 138, 0.15) 0, transparent 50%);
            background-size: 40px 40px, 40px 40px, 100% 100%, 100% 100%;
            color: var(--text-main);
            min-height: 100vh;
            padding: 40px 20px;
        }

        .container {
            max-width: 1000px;
            margin: auto;
            background: var(--panel-bg);
            backdrop-filter: blur(16px);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 40px;
            animation: card-breathe 4s infinite ease-in-out;
        }

        h2 {
            font-size: 32px;
            font-weight: 700;
            margin: 0;
            color: var(--accent-blue);
            letter-spacing: -0.025em;
            text-shadow: 0 0 15px rgba(14, 165, 233, 0.2);
        }

        .subtitle {
            color: var(--text-muted);
            margin-bottom: 30px;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .warning {
            background: rgba(14, 165, 233, 0.05);
            border: 1px solid rgba(14, 165, 233, 0.2);
            border-left: 4px solid var(--accent-blue);
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 30px;
            font-size: 15px;
            line-height: 1.6;
        }

        .section {
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding-top: 25px;
            margin-bottom: 35px;
        }

        h3 {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-main);
        }

        .meta-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            background: rgba(2, 6, 23, 0.5);
            padding: 20px;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .meta-item label {
            display: block;
            color: var(--text-muted);
            font-size: 11px;
            margin-bottom: 4px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        textarea {
            width: 100%;
            background: rgba(2, 6, 23, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 6px;
            color: #cbd5e1;
            padding: 12px;
            font-size: 14px;
            resize: none;
            transition: all 0.3s;
        }

        textarea.readonly {
            border-left: 3px solid var(--accent-blue);
            background: rgba(14, 165, 233, 0.02);
        }

        .file-drop-zone {
            border: 2px dashed rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 30px;
            text-align: center;
            background: rgba(2, 6, 23, 0.3);
            cursor: pointer;
            transition: 0.3s;
        }

        .file-drop-zone:hover {
            border-color: var(--accent-blue);
            background: rgba(14, 165, 233, 0.05);
        }

        .btn {
            padding: 12px 24px;
            border-radius: 6px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 14px;
            text-decoration: none;
        }

        .btn-download-urgent {
            background: rgba(14, 165, 233, 0.1);
            color: var(--text-main);
            border: 1px solid var(--accent-blue);
            animation: beacon-glow 2s infinite, heartbeat-scale 3s infinite;
        }

        .btn.approve {
            background: var(--accent-blue);
            color: white;
            box-shadow: 0 4px 14px var(--accent-glow);
        }

        .btn.reject {
            background: rgba(239, 68, 68, 0.1);
            color: var(--danger);
            border: 1px solid var(--danger);
        }

        .status-badge {
            background: #f59e0b;
            color: #000;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 800;
        }

        footer {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            color: var(--text-muted);
            font-size: 12px;
            display: flex;
            justify-content: space-between;
        }
    </style>
</head>

<body>

    <div class="container">
        <header>
            <h2>Supervisor Review – Digital Forensic Analysis</h2>
            <div class="subtitle">Secure Evidence Verification System v2.4</div>
        </header>

        <div class="warning">
            <strong>System Protocol:</strong> You are performing a formal review. A screen recording or CCTV footage of
            this session must be attached.
        </div>

        <div class="section">
            <h3><i data-lucide="database"></i> Evidence Information</h3>
            <div class="meta-grid">
                <div class="meta-item">
                    <label>Case ID</label>
                    <span>
                        <%= evidence.case_id %>
                    </span>
                </div>
                <div class="meta-item">
                    <label>Investigator</label>
                    <span>
                        <%= evidence.investigator_full_name %>
                    </span>
                </div>
                <div class="meta-item">
                    <label>Evidence Description</label>
                    <span>
                        <%= evidence.description %>
                    </span>
                </div>
                <div class="meta-item">
                    <label>Review Status</label>
                    <span class="status-badge">
                        <%= evidence.current_status %>
                    </span>
                </div>
            </div>
            <p style="margin-top: 25px;">
                <a href="/analyst/download/<%= evidence.evidence_id %>" class="btn btn-download-urgent">
                    <i data-lucide="download" style="width: 16px; height: 16px;"></i>
                    Download Source Evidence
                </a>
            </p>
        </div>

        <div class="section">
            <h3><i data-lucide="file-search"></i> Analyst Analysis Findings</h3>
            <div style="margin-bottom: 20px;">
                <label>Tools Used</label>
                <textarea class="readonly" readonly rows="2"><%= analysis?.tools_used || '-' %></textarea>
            </div>
            <div style="margin-bottom: 20px;">
                <label>Methodology</label>
                <textarea class="readonly" readonly rows="3"><%= analysis?.methodology || '-' %></textarea>
            </div>
            <div style="margin-bottom: 20px;">
                <label>Observations</label>
                <textarea class="readonly" readonly rows="4"><%= analysis?.observations || '-' %></textarea>
            </div>
            <div>
                <label>Conclusion</label>
                <textarea class="readonly" readonly rows="4"><%= analysis?.conclusion || '-' %></textarea>
            </div>
        </div>

        <div class="section"
            style="background: rgba(14, 165, 233, 0.03); border-radius: 12px; padding: 25px; border: 1px solid rgba(14, 165, 233, 0.2);">
            <h3><i data-lucide="shield-check"></i> Final Verification</h3>
            <form action="/supervisor/analysis/approve/<%= evidence.evidence_id %>" method="POST"
                enctype="multipart/form-data" id="approvalForm">
                <label>Supervision Proof (Video Recording)</label>
                <div class="file-drop-zone" onclick="document.getElementById('videoFile').click()">
                    <i data-lucide="video"
                        style="width: 40px; height: 40px; color: var(--accent-blue); margin-bottom: 10px;"></i>
                    <p style="margin: 0; font-weight: 500;">Click to upload CCTV / Screen Recording (MP4)</p>
                    <input type="file" id="videoFile" name="supervisor_video" accept="video/*" style="display: none;"
                        required>
                </div>
                <div style="margin-top: 20px;">
                    <label>Supervisor Notes</label>
                    <textarea name="supervisor_notes" rows="3" placeholder="Enter review findings..."></textarea>
                </div>
                <div class="actions">
                    <button type="submit" class="btn approve">
                        <i data-lucide="check-circle"></i> Authenticate & Approve
                    </button>
                </div>
            </form>
        </div>

        <div class="section">
            <h3><i data-lucide="alert-octagon"></i> Rejection</h3>
            <form action="/supervisor/reject/<%= evidence.evidence_id %>" method="POST">
                <label>Reason for Rejection</label>
                <textarea name="reason" rows="2" placeholder="Detail errors..."></textarea>
                <div style="margin-top: 15px;">
                    <button type="submit" class="btn reject">Reject Analysis</button>
                </div>
            </form>
        </div>

        <footer>
            <span>© 2026 Digital Forensic Intelligence Unit</span>
            <span>Audit: <span style="color: var(--accent-blue);">SECURE</span></span>
        </footer>
    </div>

    <script>
        lucide.createIcons();

        const videoInput = document.getElementById('videoFile');
        const dropZone = document.querySelector('.file-drop-zone');
        const dropZoneText = dropZone.querySelector('p');
        const dropZoneIcon = dropZone.querySelector('i');

        videoInput.addEventListener('change', function () {
            if (this.files && this.files[0]) {
                const fileName = this.files[0].name;
                const fileSize = (this.files[0].size / (1024 * 1024)).toFixed(2);

                dropZone.style.borderColor = "#10b981";
                dropZone.style.background = "rgba(16, 185, 129, 0.1)";


                dropZoneText.innerHTML = `<strong style="color: #10b981;">✔ Selected:</strong> ${fileName} (${fileSize} MB)`;

                dropZoneIcon.setAttribute('data-lucide', 'check-circle');
                dropZoneIcon.style.color = "#10b981";

                lucide.createIcons();
            }
        });
    </script>
</body>

</html>