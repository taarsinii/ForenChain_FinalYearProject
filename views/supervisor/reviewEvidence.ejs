<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Review Evidence</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 30px;
        }

        .evidence-box {
            border: 1px solid #333;
            padding: 20px;
            max-width: 800px;
        }

        img {
            margin-top: 10px;
            max-width: 400px;
            border: 1px solid #000;
        }

        textarea {
            width: 100%;
        }

        button {
            padding: 8px 16px;
            margin-top: 10px;
            cursor: pointer;
        }

        .approve {
            background-color: #2ecc71;
            border: none;
        }

        .reject {
            background-color: #e74c3c;
            border: none;
            color: white;
        }
    </style>
</head>

<body>

    <h2>🔍 Review Evidence </h2>

    <div class="evidence-box">

        <p><strong>Case ID:</strong>
            <%= evidence.case_id %>
        </p>

        <p><strong>Description:</strong><br>
            <%= evidence.description %>
        </p>

        <p><strong>Collected By:</strong><br>
            Investigator ID: <%= evidence.investigator %><br>
                Full Name: <%= evidence.investigator_full_name %><br>
                    Username: <%= evidence.investigator_username %>
        </p>


        <p><strong>Collected At:</strong>
            <%= new Date(evidence.timestamp_collected).toLocaleString() %>
        </p>

        <p><strong>Evidence Status:</strong>
            <%= evidence.current_status %>
        </p>

        <hr>

        <h3>📁 Uploaded Evidence</h3>

        <% if (evidence.photo_path) { %>
            <p><strong>Evidence Photo:</strong></p>
            <img src="/<%= evidence.photo_path %>" alt="Uploaded Evidence Photo">
            <% } else { %>
                <p><em>No photo uploaded by investigator.</em></p>
                <% } %>

    </div>

    <br>

    <!-- ================================ -->
    <!-- APPROVE EVIDENCE -->
    <!-- ================================ -->
    <form action="/supervisor/approve/<%= evidence.evidence_id %>" method="POST">
        <label><strong>Supervisor Notes (optional):</strong></label><br>
        <textarea name="supervisor_notes" rows="4"></textarea><br>
        <button class="approve" type="submit">✅ Approve Evidence</button>
    </form>

    <br>

    <!-- ================================ -->
    <!-- REJECT EVIDENCE -->
    <!-- ================================ -->
    <form action="/supervisor/reject/<%= evidence.evidence_id %>" method="POST">
        <label><strong>Rejection Reason (required):</strong></label><br>
        <textarea name="reason" rows="4" required></textarea><br>
        <button class="reject" type="submit">❌ Reject Evidence</button>
    </form>

    <br>
    <a href="/supervisor/pending">⬅ Back to Pending Evidence</a>

</body>

</html>