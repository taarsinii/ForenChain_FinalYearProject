<h2>Review Evidence</h2>

<p><strong>Case ID:</strong>
    <%= evidenceList[0].case_id %>
</p>
<p><strong>Description:</strong>
    <%= evidenceList[0].description %>
</p>
<p><strong>Collected By:</strong>
    <%= evidenceList[0].investigator %>
</p>

<hr>

<form action="/supervisor/approve/<%= evidenceList[0].evidence_id %>" method="POST">
    <label>Supervisor Notes (optional):</label><br>
    <textarea name="notes" rows="4" cols="50"></textarea><br><br>
    <button>Approve Evidence</button>
</form>

<hr>

<form action="/supervisor/reject/<%= evidenceList[0].evidence_id %>" method="POST">
    <label style="color:red;">Rejection Reason (required):</label><br>
    <textarea name="reason" rows="4" cols="50" required></textarea><br><br>
    <button style="color:red;">Reject Evidence</button>
</form>