<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Prosecutor Dashboard | Digital Forensic System</title>

    <style>
        :root {
            --bg0: #050810;
            --bg1: #0B1224;
            --card: rgba(255, 255, 255, 0.04);
            --card2: rgba(255, 255, 255, 0.08);
            --border: rgba(255, 255, 255, 0.12);
            --text: rgba(255, 255, 255, 0.95);
            --muted: rgba(255, 255, 255, 0.55);
            --shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
            --accent: #6EA8FE;
            --good: #10B981;
            --warn: #F59E0B;
            --bad: #EF4444;
            --info: #38BDF8;
            --focus: 0 0 0 4px rgba(110, 168, 254, .22);
            --r2: 24px;
        }

        body.light {
            --bg0: #fafbff;
            --bg1: #f3dede;
            --card: rgba(255, 255, 255, 0.75);
            --card2: rgba(255, 255, 255, 0.95);
            --border: rgba(15, 23, 42, 0.1);
            --text: #1e293b;
            --muted: #64748b;
            --shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
            --accent: #2563EB;
        }

        * {
            box-sizing: border-box;
            transition: background-color 0.3s ease, border-color 0.3s ease;
        }

        body {
            margin: 0;
            font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
            color: var(--text);
            background: var(--bg0);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* --- DYNAMIC MESH BACKGROUND --- */
        .bg-visuals {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: -1;
            background: var(--bg0);
            overflow: hidden;
        }

        .blob {
            position: absolute;
            width: 600px;
            height: 600px;
            border-radius: 50%;
            filter: blur(120px);
            opacity: 0.15;
            animation: float 25s infinite alternate ease-in-out;
        }

        .blob-1 {
            top: -150px;
            left: -150px;
            background: var(--accent);
        }

        .blob-2 {
            bottom: -150px;
            right: -150px;
            background: var(--good);
            animation-delay: -7s;
        }

        .blob-3 {
            top: 30%;
            left: 40%;
            background: #A855F7;
            animation-delay: -12s;
            opacity: 0.1;
        }

        @keyframes float {
            0% {
                transform: translate(0, 0) scale(1);
            }

            100% {
                transform: translate(120px, 80px) scale(1.15);
            }
        }

        /* --- LAYOUT & GLASS --- */
        .container {
            width: min(1200px, calc(100% - 40px));
            margin: 0 auto;
            padding: 40px 0;
            position: relative;
        }

        .glass {
            background: linear-gradient(135deg, var(--card), var(--card2));
            border: 1px solid var(--border);
            box-shadow: var(--shadow);
            backdrop-filter: blur(14px) saturate(180%);
            -webkit-backdrop-filter: blur(14px) saturate(180%);
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 32px;
            flex-wrap: wrap;
            gap: 20px;
        }

        .brand {
            display: inline-flex;
            gap: 12px;
            align-items: center;
            padding: 8px 16px;
            border-radius: 999px;
            border: 1px solid var(--border);
            background: rgba(110, 168, 254, 0.08);
        }

        .brand .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--good);
            box-shadow: 0 0 12px var(--good);
        }

        h1 {
            margin: 16px 0 8px;
            font-size: 32px;
            font-weight: 800;
            letter-spacing: -0.03em;
        }

        /* --- CARDS & STATS --- */
        .grid {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 20px;
            margin: 24px 0;
        }

        .card {
            border-radius: var(--r2);
            padding: 24px;
            position: relative;
            overflow: hidden;
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .card:hover {
            transform: translateY(-6px);
        }

        .kpi {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--muted);
        }

        .value {
            font-size: 36px;
            font-weight: 800;
            margin: 8px 0;
        }

        .sub {
            font-size: 13px;
            color: var(--muted);
            line-height: 1.4;
        }

        .pillIcon {
            width: 48px;
            height: 48px;
            border-radius: 16px;
            display: grid;
            place-items: center;
            font-size: 20px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border);
        }

        /* --- TABLE & CONTROLS --- */
        .panel {
            border-radius: var(--r2);
            padding: 28px;
        }

        .controls {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            align-items: center;
        }

        .input {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 10px 16px;
            min-width: 280px;
        }

        .input input {
            background: transparent;
            border: none;
            color: var(--text);
            outline: none;
            width: 100%;
            font-size: 14px;
        }

        select {
            background: rgba(0, 0, 0, 0.2);
            color: var(--text);
            border: 1px solid var(--border);
            padding: 10px 16px;
            border-radius: 14px;
            outline: none;
            cursor: pointer;
        }

        .tableWrap {
            margin-top: 24px;
            border-radius: 16px;
            border: 1px solid var(--border);
            overflow: hidden;
            background: rgba(0, 0, 0, 0.1);
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            background: rgba(255, 255, 255, 0.03);
            text-align: left;
            padding: 16px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--muted);
            border-bottom: 1px solid var(--border);
        }

        tbody tr {
            border-bottom: 1px solid var(--border);
            transition: 0.2s;
        }

        tbody tr:hover {
            background: rgba(110, 168, 254, 0.05);
            cursor: pointer;
        }

        tbody td {
            padding: 18px 16px;
            vertical-align: middle;
        }

        .btn {
            padding: 10px 18px;
            border-radius: 12px;
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.05);
            color: var(--text);
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: 0.2s;
        }

        .btn:hover {
            background: var(--accent);
            color: #fff;
            transform: translateY(-2px);
        }

        .badge {
            padding: 6px 12px;
            border-radius: 99px;
            background: rgba(255, 255, 255, 0.05);
            font-size: 12px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: 1px solid var(--border);
        }

        .bDot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        .col-4 {
            grid-column: span 4;
        }

        .col-12 {
            grid-column: span 12;
        }

        @media (max-width: 900px) {
            .col-4 {
                grid-column: span 12;
            }
        }

        footer {
            margin-top: 40px;
            text-align: center;
            color: var(--muted);
            font-size: 13px;
        }
    </style>
</head>

<body>
    <div class="bg-visuals">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>
    </div>

    <% const safeCases=Array.isArray(cases) ? cases : []; %>

        <div class="container">
            <div class="topbar">
                <div>
                    <div class="brand">
                        <span class="dot"></span>
                        <div style="font-weight:800; font-size: 14px;">Digital Forensic System</div>
                    </div>
                    <h1>Prosecutor Dashboard</h1>
                    <div class="muted">Monitor and manage evidence chains of custody in real-time.</div>
                </div>

                <div class="actions">
                    <button class="btn" id="btnTheme">🌓 Theme</button>
                    <button class="btn" id="btnRefresh">⟳ Refresh</button>
                </div>
            </div>

            <div class="grid">
                <div class="card glass col-4">
                    <div class="kpi">
                        <div>
                            <div class="label">Total Cases</div>
                            <div class="value">
                                <%= safeCases.length %>
                            </div>
                            <div class="sub">Active forensic investigations.</div>
                        </div>
                        <div class="pillIcon">📁</div>
                    </div>
                </div>

                <div class="card glass col-4">
                    <div class="kpi">
                        <div>
                            <div class="label">Most Common Status</div>
                            <div class="value" style="font-size:22px;" id="kpiCommon">—</div>
                            <div class="sub">Current primary workflow stage.</div>
                        </div>
                        <div class="pillIcon">📊</div>
                    </div>
                </div>

                <div class="card glass col-4">
                    <div class="kpi">
                        <div style="width: 100%;">
                            <div class="label">Status Distribution</div>
                            <div id="breakdown"
                                style="display:flex; flex-direction: column; gap:10px; margin-top:12px;"></div>
                        </div>
                    </div>
                </div>

                <div class="panel glass col-12">
                    <div
                        style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
                        <h2 style="margin:0; font-size: 20px;">Evidence Records</h2>
                        <div class="controls">
                            <div class="input">
                                <span>🔎</span>
                                <input id="searchInput" placeholder="Search case, status, or ID...">
                            </div>
                            <select id="statusSelect">
                                <option value="">All Statuses</option>
                            </select>
                            <select id="pageSize">
                                <option value="8">8 per page</option>
                                <option value="12" selected>12 per page</option>
                                <option value="20">20 per page</option>
                            </select>
                            <button class="btn" id="btnClear">✕</button>
                        </div>
                    </div>

                    <div class="tableWrap">
                        <table>
                            <thead>
                                <tr>
                                    <th data-col="case" style="cursor:pointer">Case ID ↕</th>
                                    <th data-col="status" style="cursor:pointer">Status ↕</th>
                                    <th data-col="evidence" style="cursor:pointer">Evidence ID ↕</th>
                                    <th style="text-align: right;">Action</th>
                                </tr>
                            </thead>
                            <tbody id="tbody">
                                <% safeCases.forEach(c=> { %>
                                    <tr data-case="<%= c.case_id %>" data-status="<%= c.current_status %>"
                                        data-evidence="<%= c.evidence_id %>"
                                        data-href="/prosecutor/case/<%= encodeURIComponent(c.evidence_id) %>">
                                        <td style="font-weight:700;">#<%= c.case_id %>
                                        </td>
                                        <td>
                                            <span class="badge">
                                                <span class="bDot"></span>
                                                <%= c.current_status %>
                                            </span>
                                        </td>
                                        <td class="muted">
                                            <%= c.evidence_id %>
                                        </td>
                                        <td style="text-align: right;">
                                            <a href="/prosecutor/case/<%= encodeURIComponent(c.evidence_id) %>"
                                                class="btn" style="padding: 6px 12px; font-size: 12px;">View Chain</a>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <div style="margin-top: 20px; display: flex; justify-content: space-between; align-items: center;">
                        <div class="muted" id="pageInfo" style="font-size: 13px;"></div>
                        <div style="display: flex; gap: 8px;">
                            <button class="btn" id="prevBtn">‹</button>
                            <button class="btn" id="pageNum" disabled>1</button>
                            <button class="btn" id="nextBtn">›</button>
                        </div>
                    </div>
                </div>
            </div>

            <footer>
                <p>&copy; <span id="year"></span> Digital Forensic System • Secured Ledger Technology</p>
            </footer>
        </div>

        <script>
            // --- Core Logic ---
            const themeKey = "dfs_theme_v2";
            const body = document.body;
            const tbody = document.getElementById("tbody");
            const allRows = Array.from(tbody.querySelectorAll("tr"));
            document.getElementById("year").textContent = new Date().getFullYear();

            // Theme Toggle
            if (localStorage.getItem(themeKey) === "light") body.classList.add("light");
            document.getElementById("btnTheme").addEventListener("click", () => {
                body.classList.toggle("light");
                localStorage.setItem(themeKey, body.classList.contains("light") ? "light" : "dark");
            });

            document.getElementById("btnRefresh").addEventListener("click", () => location.reload());

            // Row Navigation
            allRows.forEach(tr => {
                tr.addEventListener("click", (e) => {
                    if (!e.target.closest("a")) window.location.href = tr.dataset.href;
                });
            });

            // Status Colors
            function getStatusColor(status) {
                const s = status.toLowerCase();
                if (s.includes("open") || s.includes("new")) return "#38BDF8";
                if (s.includes("progress") || s.includes("processing")) return "#F59E0B";
                if (s.includes("closed") || s.includes("complete")) return "#10B981";
                if (s.includes("reject") || s.includes("fail")) return "#EF4444";
                return "#6EA8FE";
            }

            allRows.forEach(tr => {
                const dot = tr.querySelector(".bDot");
                if (dot) dot.style.background = getStatusColor(tr.dataset.status);
            });

            // Data Aggregation
            const counts = {};
            allRows.forEach(tr => {
                const s = tr.dataset.status;
                counts[s] = (counts[s] || 0) + 1;
            });

            const sortedEntries = Object.entries(counts).sort((a, b) => b[1] - a[1]);
            document.getElementById("kpiCommon").textContent = sortedEntries[0] ? `${sortedEntries[0][0]} (${sortedEntries[0][1]})` : "—";

            // Status Select Populate
            const statusSelect = document.getElementById("statusSelect");
            sortedEntries.forEach(([st]) => {
                const opt = document.createElement("option");
                opt.value = st; opt.textContent = st;
                statusSelect.appendChild(opt);
            });

            // Breakdown UI
            const breakdown = document.getElementById("breakdown");
            const totalRows = allRows.length || 1;
            breakdown.innerHTML = sortedEntries.slice(0, 3).map(([st, n]) => {
                const pct = (n / totalRows) * 100;
                return `
                <div style="font-size: 12px;">
                    <div style="display:flex; justify-content:space-between; margin-bottom:4px;">
                        <span>${st}</span>
                        <span class="muted">${Math.round(pct)}%</span>
                    </div>
                    <div style="height:6px; background:rgba(255,255,255,0.1); border-radius:10px; overflow:hidden;">
                        <div style="width:${pct}%; height:100%; background:${getStatusColor(st)};"></div>
                    </div>
                </div>`;
            }).join("");

            // --- Filtering & Pagination ---
            let state = { q: "", status: "", page: 1, size: 12, sortCol: "case", sortDir: "asc" };

            function apply() {
                const filtered = allRows.filter(tr => {
                    const text = tr.innerText.toLowerCase();
                    const matchQ = !state.q || text.includes(state.q.toLowerCase());
                    const matchS = !state.status || tr.dataset.status === state.status;
                    return matchQ && matchS;
                });

                // Sorting
                filtered.sort((a, b) => {
                    let av = a.dataset[state.sortCol], bv = b.dataset[state.sortCol];
                    if (!isNaN(av)) { av = Number(av); bv = Number(bv); }
                    const res = av > bv ? 1 : -1;
                    return state.sortDir === "asc" ? res : -res;
                });

                const total = filtered.length;
                const pages = Math.ceil(total / state.size) || 1;
                state.page = Math.min(state.page, pages);

                const start = (state.page - 1) * state.size;
                allRows.forEach(r => r.style.display = "none");
                filtered.slice(start, start + state.size).forEach(r => r.style.display = "");

                document.getElementById("pageInfo").textContent = `Showing ${total ? start + 1 : 0} to ${Math.min(start + state.size, total)} of ${total} entries`;
                document.getElementById("pageNum").textContent = state.page;
                document.getElementById("prevBtn").disabled = state.page === 1;
                document.getElementById("nextBtn").disabled = state.page === pages;
            }

            // Listeners
            document.getElementById("searchInput").addEventListener("input", e => { state.q = e.target.value; state.page = 1; apply(); });
            document.getElementById("statusSelect").addEventListener("change", e => { state.status = e.target.value; state.page = 1; apply(); });
            document.getElementById("pageSize").addEventListener("change", e => { state.size = Number(e.target.value); state.page = 1; apply(); });
            document.getElementById("prevBtn").addEventListener("click", () => { state.page--; apply(); });
            document.getElementById("nextBtn").addEventListener("click", () => { state.page++; apply(); });
            document.getElementById("btnClear").addEventListener("click", () => {
                document.getElementById("searchInput").value = "";
                document.getElementById("statusSelect").value = "";
                state.q = ""; state.status = ""; apply();
            });

            document.querySelectorAll("thead th[data-col]").forEach(th => {
                th.addEventListener("click", () => {
                    const col = th.dataset.col;
                    state.sortDir = (state.sortCol === col && state.sortDir === "asc") ? "desc" : "asc";
                    state.sortCol = col;
                    apply();
                });
            });

            apply(); // Init
        </script>
</body>

</html>